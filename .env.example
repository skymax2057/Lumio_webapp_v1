# =============================================
# BASE DE DONNÉES (PostgreSQL)
# =============================================
# En local : créer une DB PostgreSQL ou utiliser Neon (neon.tech)
# En production : URL fournie par Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/lumio"

# =============================================
# AUTHENTICATION (NextAuth v5)
# =============================================
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# URL de ton app — localhost en dev, domaine complet en prod
NEXTAUTH_URL="http://localhost:3000"
# En production :
# NEXTAUTH_URL="https://your-app.vercel.app"

# =============================================
# OAUTH PROVIDERS
# =============================================
# Google : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub : https://github.com/settings/developers
GITHUB_ID=""
GITHUB_SECRET=""

# =============================================
# CLOUDINARY (stockage d'images)
# =============================================
# Compte gratuit : https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
