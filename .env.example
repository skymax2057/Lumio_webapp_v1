# Variables d'Environnement - Lumio App Web
# Copiez ce fichier en .env et remplissez les valeurs réelles

# ============================================
# AUTHENTIFICATION & SÉCURITÉ (OBLIGATOIRE)
# ============================================
# Secret pour NextAuth v5 - Générez un secret aléatoire de 32+ caractères
# Commande: openssl rand -base64 32
NEXTAUTH_SECRET=votre_secret_aleatoire_ici
AUTH_SECRET=votre_secret_aleatoire_ici

# OAuth Providers - Google
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret

# OAuth Providers - GitHub
GITHUB_ID=votre_github_client_id
GITHUB_SECRET=votre_github_client_secret

# ============================================
# BASE DE DONNÉES NEON POSTGRESQL (OBLIGATOIRE)
# ============================================
# IMPORTANT: sslmode=require est OBLIGATOIRE pour la sécurité
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ============================================
# RATE LIMITING (RECOMMANDÉ EN PRODUCTION)
# ============================================
# Upstash Redis pour le rate limiting
# Créez un compte gratuit sur https://upstash.com/
UPSTASH_REDIS_REST_URL=https://votre-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=votre_upstash_redis_token

# ============================================
# SERVICES EXTERNES
# ============================================
# Cloudinary - Stockage d'images
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Google Gemini AI - Génération de contenu
GEMINI_API_KEY=votre_gemini_api_key

# Seed Categories (optionnel)
SEED_SECRET=votre_secret_pour_seed_categories

# ============================================
# CORS CONFIGURATION
# ============================================
# Liste des origines autorisées, séparées par des virgules
# En développement: http://localhost:3000
# En production: https://votre-domaine.com,https://www.votre-domaine.com
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=development